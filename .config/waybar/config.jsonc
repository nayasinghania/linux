// -*- mode: jsonc -*-
{
  "position": "top",
    "margin-top": 5,
    "margin-left": 5,
    "margin-right": 5,
    "height": 36,
    "spacing": 4,

    "modules-left": [
        "wlr/taskbar"
    ],

    "modules-center": [
        "custom/thunar",
        "custom/librewolf",
        "custom/obsidian",
        "custom/discord",
        "custom/zed",
        "custom/zoom",
        "custom/bitwig"
    ],

    "modules-right": [
        "group/right"
    ],

    "group/right": {
        "orientation": "horizontal",
        "modules": [
            "tray",
            "pulseaudio",
            "clock"
        ]
    },

    "custom/thunar": {
        "format": " ",
        "on-click": "uwsm app -- thunar",
        "tooltip": true,
        "tooltip-text": "Thunar"
    },

    "custom/librewolf": {
        "format": " ",
        "on-click": "uwsm app -- librewolf",
        "tooltip": true,
        "tooltip-text": "LibreWolf"
    },

    "custom/obsidian": {
        "format": " ",
        "on-click": "uwsm app -- obsidian",
        "tooltip": true,
        "tooltip-text": "Obsidian"
    },

    "custom/discord": {
        "format": " ",
        "on-click": "uwsm app -- discord",
        "tooltip": true,
        "tooltip-text": "Discord"
    },

    "custom/zed": {
        "format": " ",
        "on-click": "uwsm app -- zeditor",
        "tooltip": true,
        "tooltip-text": "Zed"
    },

    "custom/zoom": {
        "format": " ",
        "on-click": "uwsm app -- zoom",
        "tooltip": true,
        "tooltip-text": "Zoom"
    },

    "custom/bitwig": {
        "format": " ",
        "on-click": "uwsm app -- bitwig-studio",
        "tooltip": true,
        "tooltip-text": "Bitwig Studio"
    },

    "pulseaudio": {
        "format": "{volume}% <span font_family='Font Awesome 7 Free Solid'>\uf028</span>",
        "on-click": "pavucontrol"
    },
}
