// -*- mode: jsonc -*-
{
    "position": "top",
    "margin-top": 7,
    "margin-left": 7,
    "margin-right": 7,
    "spacing": 3,

    "modules-left": [
        "wlr/taskbar",
        "tray",
    ],

    "modules-center": [
      "mpris",

    ],

    "modules-right": [
        "pulseaudio",
        "group/connectivity",
        "clock"
    ],

    "group/connectivity": {
        "orientation": "horizontal",
        "modules": [
            "bluetooth",
            "network"
        ]
    },

    "mpris": {
        "format": "{status_icon} {title} - {artist}",
        "format-paused": "{status_icon} {title} - {artist}",
        "status-icons": {
            "playing": "",
            "paused": "",
            "stopped": ""
        },
        "tooltip-format": "{player}\n{artist{title}",
        "on-click": "play-pause",
        "on-click-middle": "previous",
        "on-click-right": "next"
    },

    "tray": {
      "icon-size": 16,
      "spacing": 8
    },

    "pulseaudio": {
        "format": "{volume}%  ",
        "on-click": "pavucontrol"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-on": "󰂯",
        "format-off": "󰂲",
        "on-click": "env DMENU_BLUETOOTH_LAUNCHER='fuzzel --dmenu' dmenu-bluetooth"
    },

    "network": {
        "format-wifi": "󰤨 ",
        "format-disconnected": "󰤭 ",

        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%",
        "on-click": "uwsm app -- networkmanager_dmenu"
    }
}
