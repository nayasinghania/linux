// -*- mode: jsonc -*-
{
    "position": "top",
    "margin-top": 7,
    "margin-left": 7,
    "margin-right": 7,
    "spacing": 3,
    "modules-left": [
        "wlr/taskbar",
        "tray",
    ],
    "modules-center": [
      "mpris",

    ],
    "modules-right": [
        "pulseaudio",
        "group/connectivity",
        "clock#time",
        "clock#date"
    ],
    "group/connectivity": {
        "orientation": "horizontal",
        "modules": [
            "bluetooth",
            "network"
        ]
    },
    "wlr/taskbar": {
      "icon-size": 20,
    },
    "tray": {
      "icon-size": 20,
      "spacing": 8
    },
    "mpris": {
        "format": "{status_icon} {title} - {artist}",
        "format-paused": "{status_icon} {title} - {artist}",
        "status-icons": {
            "playing": "",
            "paused": "",
            "stopped": ""
        },
        "tooltip-format": "{player}\n{artist{title}",
    },
    "pulseaudio": {
        "format": "{volume}%  ",
        "on-click": "pavucontrol"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-on": "󰂯",
        "format-off": "󰂲",
        "tooltip-format": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
        "on-click": "env DMENU_BLUETOOTH_LAUNCHER='fuzzel --dmenu' dmenu-bluetooth"
    },

    "network": {
        "format-wifi": "󰤨 ",
        "format-disconnected": "󰤭 ",
        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%",
        "on-click": "uwsm app -- networkmanager_dmenu"
    },
    "clock#time": {
    	"interval": 60,
    	"format": "{:%H:%M}",
    },
    "clock#date": {
    	"interval": 60,
     "format": "{:%B %d}"    }
}
